# cpa-panel 环境变量示例
#
# 用法：cp .env.example .env  （cpa-panel 本身不读 .env，
# 请在 shell / systemd / docker compose 里注入这些变量）
#
# 全部变量都有 CPAPANEL_ 前缀，可覆盖同名配置项。

# ---------- Web ----------
CPAPANEL_HOST=127.0.0.1
CPAPANEL_PORT=18317
# 反向代理后面时填外部可访问地址（用于生成 OAuth 回跳）
# CPAPANEL_PUBLIC_URL=https://panel.example.com
# 仅在可信反代后面才打开（会信任 X-Forwarded-For）
# CPAPANEL_TRUST_PROXY_HEADERS=false
CPAPANEL_LOG_LEVEL=INFO

# ---------- 路径 ----------
CPAPANEL_DATA_DIR=data
CPAPANEL_DATABASE=data/panel.db
CPAPANEL_CONFIG=panel.config.json

# ---------- 管理员引导（仅 init 时使用，不会明文落盘） ----------
CPAPANEL_ADMIN_USERNAME=admin
CPAPANEL_ADMIN_PASSWORD=改成你自己的强口令

# ---------- 首个 CPA 节点（init 时写入数据库） ----------
CPAPANEL_NODE_NAME=default
CPAPANEL_NODE_URL=http://127.0.0.1:8317
# 上游管理密钥：在 CLIProxyAPI 配置里设置管理密钥后才有管理 API
# ★ 没设置这个密钥时，上游所有 /vN/management/* 都会返回 404
CPAPANEL_NODE_KEY=sk-你的管理密钥
# auto | v0 | v8
CPAPANEL_NODE_PREFIX=auto
